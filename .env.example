# Klucz Anthropic – opcjonalny. Bez niego pisma składa wyłącznie szablon (bez redakcji AI).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# dev = płatność symulowana (od razu odblokowuje pismo), stripe = prawdziwy Stripe Checkout
PAYMENTS_MODE=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_PATH=./data/pisma.db
DOCUMENT_TOKEN_SECRET=change-me-to-a-long-random-string
# --- fala 2 ---
# wysyłka linku do pisma e-mailem (https://resend.com); bez klucza funkcja jest ukryta
RESEND_API_KEY=
EMAIL_FROM=PismoGotowe <pisma@twojadomena.pl>
# sekret do endpointu czyszczącego stare pisma (wywoływany z crona raz dziennie)
CRON_SECRET=
DOCUMENT_RETENTION_DAYS=90
# cena pakietu 5 pism w groszach
PACKAGE_PRICE_GROSZE=5900
# opcjonalna analityka (Plausible) – domena serwisu
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
