# Klucz Anthropic – opcjonalny. Bez niego pisma składa wyłącznie szablon (bez redakcji AI).
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# dev = płatność symulowana (od razu odblokowuje pismo), stripe = prawdziwy Stripe Checkout
PAYMENTS_MODE=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
DATABASE_PATH=./data/pisma.db
DOCUMENT_TOKEN_SECRET=change-me-to-a-long-random-string
